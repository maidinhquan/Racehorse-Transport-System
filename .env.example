# Copy this file to .env and fill in your local secrets (never commit .env to Git)

# SQL Server Credentials for Docker Backend connecting to Host Machine
SQL_USER=sa
SQL_PASSWORD=YOUR_SQL_PASSWORD

# JWT Authentication Secret (at least 32 characters)
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS

# Email SMTP Credentials for Registration OTP (set REGISTRATION_EMAIL_MODE=Smtp to send real emails)
REGISTRATION_EMAIL_MODE=Development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=YOUR_GMAIL_ADDRESS

# Map Routing & Geocoding API Tokens
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

