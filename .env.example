Flow1__Maps__Mapbox__Attribution='© Mapbox © OpenStreetMap'
Flow1__Estimate__StandardVehicleCapacityStalls='1'
Flow1__Vnpay__ReturnUrl='http://localhost:5173/customer/payments/return'
Flow1__Vnpay__TmnCode=''
Flow1__Vnpay__HashSecret=''
Flow1__Vnpay__Enabled='true'
