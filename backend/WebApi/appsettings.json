{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=HorseTransportDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "RaceHorseTransportBackend",
    "Audience": "RaceHorseTransportFrontend",
    "ExpireMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Registration": {
    "OtpLifetimeSeconds": 300,
    "SessionLifetimeSeconds": 900,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5,
    "MaxEmailsPerWindow": 5,
    "EmailWindowSeconds": 900
  },
  "RegistrationEmail": {
    "Mode": "Development",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "From": "",
      "EnableSsl": true
    }
  },
  "Maps": {
    "Provider": "MAPBOX",
    "Mapbox": {
      "AccessToken": "",
      "DirectionsBaseUrl": "https://api.mapbox.com/directions/v5/mapbox/driving-traffic/"
    },
    "Geoapify": {
      "ApiKey": "",
      "BaseUrl": "https://api.geoapify.com/"
    }
  },
  "AllowedHosts": "*"
}
