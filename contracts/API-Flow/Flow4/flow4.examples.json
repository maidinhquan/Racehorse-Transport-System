  "scenarios": [
    {
      "id": "road-departure",
      "given": "Manager đã duyệt, precheck đạt",
      "when": "J05 với version vừa đọc",
      "then": "Trip IN_TRANSIT, Request IN_PROGRESS, chỉ một DEPARTED, thông báo sau commit"
    },
    {
      "id": "approval-is-not-departure",
      "given": "Trip READY_TO_DEPART",
      "when": "GET J03/J04, thời gian plannedDepart tới",
      "then": "Không tự DEPARTED"
    },
    {
      "id": "readiness-race",
      "given": "J04 canDepart=true rồi xe bị hỏng",
      "when": "J05",
      "then": "409 READINESS_CHANGED hoặc INCIDENT_BLOCKING, không commit"
    },
    {
      "id": "next-only",
      "given": "Mốc 1 chưa hoàn tất",
      "when": "J06 mốc 2",
      "then": "409 MILESTONE_NOT_NEXT"
    },
    {
      "id": "completed-locked",
      "given": "Mốc đã COMPLETED",
      "when": "Gửi key mới cho cùng mốc",
      "then": "409 MILESTONE_ALREADY_COMPLETED"
    },
    {
      "id": "idempotent-retry",
      "given": "J05 đã commit",
      "when": "Retry cùng principal/key/body",
      "then": "Response gốc; không thêm history/outbox/mốc"
    },
    {
      "id": "idempotency-conflict",
      "given": "Key đã dùng",
      "when": "Cùng key nhưng khác body/path",
      "then": "409 IDEMPOTENCY_CONFLICT"
    },
    {
      "id": "different-leg",
      "given": "Tài xế outbound",
      "when": "Hoàn tất inbound hoặc dùng file Trip khác",
      "then": "404 tài nguyên ngoài scope hoặc 409 NOT_ASSIGNED_LEG khi có quyền xem Trip"
    },
    {
      "id": "checkpoint-held",
      "given": "CHECKPOINT_ARRIVED, kết quả HELD",
      "when": "J06 CHECKPOINT_DEPARTED",
      "then": "409 CHECKPOINT_NOT_CLEARED; J23 chăm sóc vẫn được"
    },
    {
      "id": "checkpoint-clearance",
      "given": "Specialist CLEARED có bằng chứng",
      "when": "Còn sự cố sức khỏe chặn",
      "then": "Vẫn chặn đi tiếp; không coi CLEARED gỡ mọi blocker"
    },
    {
      "id": "air-sequence",
      "given": "AIR plan đã duyệt và booking thật",
      "when": "Outbound DEPARTED → airport → J13 → J14 actual departure → actual arrival → J15 → inbound DEPARTED → FINAL_ARRIVED",
      "then": "Kiểm next/scope/bằng chứng; AIR_HANDOVER và AIR_RECEIVED thông báo ba bên"
    },
    {
      "id": "air-estimate",
      "given": "Đã tới giờ bay dự kiến",
      "when": "J14 ESTIMATED_SCHEDULE hoặc GET",
      "then": "Không AIR_DEPARTED/AIR_ARRIVED tự động, không đổi approved snapshot"
    },
    {
      "id": "air-missing-horse",
      "given": "Có hai ngựa",
      "when": "J13/J15 chỉ gửi một ngựa",
      "then": "409 HORSE_SET_MISMATCH"
    },
    {
      "id": "correction-pending",
      "given": "Mốc đã hoàn tất",
      "when": "J08",
      "then": "Giữ nguyên mốc, lưu original/proposed"
    },
    {
      "id": "correction-order",
      "given": "Giờ sửa vượt giờ mốc kế tiếp",
      "when": "J10 APPROVE",
      "then": "409 INVALID_EVENT_TIME, giữ cả yêu cầu và dữ liệu gốc"
    },
    {
      "id": "correction-history",
      "given": "Yêu cầu hợp lệ đúng revision",
      "when": "J10 APPROVE",
      "then": "Tăng revision, lưu cả before/after/actor/reason, không lùi Trip state"
    },
    {
      "id": "eta-proposal",
      "given": "ETA hiện hành 18:00",
      "when": "J17 đề xuất 19:00",
      "then": "Hiển thị hai ETA, current vẫn 18:00"
    },
    {
      "id": "eta-manager",
      "given": "ETA vượt hạn giao hoặc đổi lịch chính thức",
      "when": "J20 APPROVE",
      "then": "PENDING_MANAGER, chưa đổi currentEta; J21 cần phương án Flow5 hợp lệ"
    },
    {
      "id": "incident-link",
      "given": "Chậm do xe hỏng",
      "when": "Đề xuất chỉ ghi lý do, không incident",
      "then": "409 INCIDENT_REQUIRED; không dùng ETA thay xử lý sự cố"
    },
    {
      "id": "health-abnormal",
      "given": "Ngựa có dấu hiệu bất thường",
      "when": "J23 ABNORMAL không incident",
      "then": "Lưu quan sát ngay, incidentRequired=true, không coi gate vận chuyển đạt"
    },
    {
      "id": "vet-permission",
      "given": "Driver không phải bác sĩ được phân công",
      "when": "J25 FIT",
      "then": "403 hoặc 409 VETERINARIAN_REQUIRED; không ghi kết luận"
    },
    {
      "id": "vet-not-fit",
      "given": "Bác sĩ kết luận NOT_FIT",
      "when": "J06 đi tiếp",
      "then": "409 INCIDENT_BLOCKING; chăm sóc tiếp tục"
    },
    {
      "id": "health-check-gate",
      "given": "Trạm dừng có requiresHealthCheck=true",
      "when": "J06 hoàn thành mốc khi chưa có Health Log",
      "then": "409 HEALTH_CHECK_REQUIRED, mốc tiếp tục bị khóa"
    },
    {
      "id": "vet-clearance-gate",
      "given": "Có ngựa ABNORMAL chưa được bác sĩ khám FIT",
      "when": "J06 hoặc J13",
      "then": "409 VET_CLEARANCE_REQUIRED hoặc INCIDENT_BLOCKING"
    },
    {
      "id": "petty-cash-expense",
      "given": "Phát sinh phí cầu đường BOT",
      "when": "J36 gửi chi phí kèm ảnh vé",
      "then": "Ghi nhận EXPENSE_001, status RECORDED, chi phí nội bộ không tự sửa tiền khách hàng"
    },
    {
      "id": "customer-scope",
      "given": "Customer A",
      "when": "Đọc request/file/horse của B",
      "then": "404, không lộ sự tồn tại hoặc nội dung nội bộ"
    },
    {
      "id": "file-validation",
      "given": "Upload giả JPEG hoặc HEALTH PDF hoặc >10MiB",
      "when": "J30",
      "then": "400/415/413; không file được gắn nghiệp vụ"
    },
    {
      "id": "alerts-policy",
      "given": "Ngưỡng policy null",
      "when": "Chạy job cảnh báo",
      "then": "Không tự đặt 30 phút/ảnh; UI hiện chưa cấu hình"
    },
    {
      "id": "alert-ack",
      "given": "Cảnh báo OPEN",
      "when": "J28/J29",
      "then": "Chỉ ack/contact, không tự hoàn tất mốc"
    },
    {
      "id": "last-location",
      "given": "Chưa có mốc geo xác nhận",
      "when": "J32 map",
      "then": "markerGeo=null; không nội suy vị trí GPS"
    },
    {
