SQL_PASSWORD=''
REGISTRATION_EMAIL_MODE='Smtp'
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
Jwt__Key=''
Jwt__Issuer='RaceHorseTransportBackend'
Jwt__Audience='RaceHorseTransportFrontend'
Jwt__ExpireMinutes='1440'
Flow1__Maps__Provider='MAPBOX'
Flow1__Maps__DataProvider='GEOAPIFY'
Flow1__Maps__MayPersistResults='true'
Flow1__Maps__Geoapify__ApiKey=''
