# Copy to .env and fill in the blanks. Never commit .env (it is in .gitignore).
# Ask the team for the real values (VNPay sandbox, Gmail app password, map keys).

# SQL Server Credentials for Docker Backend connecting to Host Machine
SQL_USER=
SQL_PASSWORD=
SQL_DATABASE=HorseTransportDB_Reviewed

# Email SMTP Credentials for Registration OTP
REGISTRATION_EMAIL_MODE=Smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Backend secrets (passed to the container via env_file in compose.yaml)
Jwt__Key=
Flow1__Contracts__OtpHmacKey=

# MAPS
Flow1__Maps__Provider=MAPBOX
Flow1__Maps__DataProvider=GEOAPIFY
Flow1__Maps__MayPersistResults=true
Flow1__Maps__Geoapify__ApiKey=
Flow1__Maps__Geoapify__ApiBaseUrl=https://api.geoapify.com/
Flow1__Maps__Mapbox__AccessToken=
Flow1__Maps__Mapbox__PermanentGeocodingEnabled=true
Flow1__Maps__Mapbox__Attribution=© Mapbox © OpenStreetMap

# VNPAY Sandbox
Flow1__Vnpay__HashSecret=
Flow1__Vnpay__TmnCode=

# CONTRACT
Flow1__Contracts__Issuer__legalName='CBNTransport'
Flow1__Contracts__Issuer__address='FPT University, Ho Chi Minh City, Vietnam'
Flow1__Contracts__Issuer__email='contact@cbntransport.com'
Flow1__Contracts__Issuer__phone='+84 123 456 789'
Flow1__Contracts__Issuer__representative='Group 4 - SWP391'
Flow1__Contracts__Issuer__taxCode='123456789'
Flow1__Contracts__BrowserExecutablePath=/usr/bin/chromium

# VNPAY IPN TUNNEL (optional) - lets VNPay reach this machine's backend.
# 1) Free account at https://dashboard.ngrok.com -> copy the authtoken and claim the free static domain.
# 2) Register https://<NGROK_DOMAIN>/api/payments/vnpay/ipn as the IPN URL of the VNPay sandbox merchant (once).
# 3) Keep COMPOSE_PROFILES=tunnel so `docker compose up` starts the tunnel automatically.
# No account? Use COMPOSE_PROFILES=quicktunnel instead: random URL shown at http://localhost:2000/quicktunnel,
#    it changes on every restart (update the VNPay IPN URL each time).
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
