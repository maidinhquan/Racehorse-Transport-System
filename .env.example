# =============================================================================
# 1. DATABASE (SQL SERVER)
# =============================================================================
SQL_USER=sa
SQL_PASSWORD=your_sql_password_here
SQL_DATABASE=HorseTransportDB

# =============================================================================
# 2. BẢO MẬT & XÁC THỰC (JWT & OTP)
# =============================================================================
# JWT_SECRET_KEY và OTP_HMAC_KEY: Chuỗi ngẫu nhiên >= 32 bytes
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_bytes_long_2026!
OTP_HMAC_KEY=your_otp_hmac_secret_key_at_least_32_bytes_2026!

# =============================================================================
# 3. GỬI EMAIL THÔNG BÁO & OTP (GMAIL SMTP)
# =============================================================================
REGISTRATION_EMAIL_MODE=Smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com

# =============================================================================
# 4. BẢN ĐỒ & ĐỊNH VỊ (MAPS)
# =============================================================================
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# =============================================================================
# 5. CỔNG THANH TOÁN VNPAY (SANDBOX)
# =============================================================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:5173/customer/payments/return
# Các địa chỉ web được phép nhận kết quả thanh toán, cách nhau bằng dấu phẩy (đổi khi chạy qua ngrok/tên miền khác)
VNPAY_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# 6. THÔNG TIN PHÁP NHÂN CÔNG TY (IN TRÊN HỢP ĐỒNG)
# =============================================================================
COMPANY_NAME=CBNTransport
COMPANY_ADDRESS=FPT University, Ho Chi Minh City, Vietnam
COMPANY_PHONE=+84 123 456 789
COMPANY_REPRESENTATIVE=Group 4 - SWP391
COMPANY_TAX_CODE=123456789

# =============================================================================
# 7. TIỆN ÍCH KHÁC (NGROK & EMAIL VALIDATION)
# =============================================================================
# Tunnel ngrok tự chạy khi `docker compose up` nếu có NGROK_AUTHTOKEN bên dưới (không cần COMPOSE_PROFILES).
# Muốn dùng Cloudflare Quick Tunnel không cần tài khoản thì bỏ dấu # ở dòng sau:
# COMPOSE_PROFILES=quicktunnel
NGROK_AUTHTOKEN=
EMAIL_VALIDATION_API_KEY=

# =============================================================================
# 8. GOOGLE OAUTH
# =============================================================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
